<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Darkroom timer step-complete alert -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Reminder notifications (film expiry, undeveloped rolls, chemical age) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!-- osmdroid tile cache -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />

    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:name=".AnalogVaultApp"
        android:label="${appLabel}"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.AnalogVault"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:supportsRtl="true"
        android:hardwareAccelerated="true">

        <!-- The app's one activity. It has no launcher entry of its own: the
             launcher reaches it through one of the aliases below, the icon
             picked in Settings → Display. Exactly one alias is enabled at a
             time (AppIconSwitcher). -->
        <activity
            android:name=".VaultActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|keyboard|smallestScreenSize"
            android:windowSoftInputMode="adjustResize" />

        <!-- The Dye Layer icon, and the name the launcher has always known: a
             home-screen shortcut made before alternate icons keeps working. -->
        <activity-alias
            android:name=".MainActivity"
            android:targetActivity=".VaultActivity"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher_round">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".IconLegacyAmber"
            android:targetActivity=".VaultActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_legacy_amber"
            android:roundIcon="@mipmap/ic_launcher_legacy_amber">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".IconExpired"
            android:targetActivity=".VaultActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_expired"
            android:roundIcon="@mipmap/ic_launcher_expired">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".IconCyanotype"
            android:targetActivity=".VaultActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_cyanotype"
            android:roundIcon="@mipmap/ic_launcher_cyanotype">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".IconSlide"
            android:targetActivity=".VaultActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_slide"
            android:roundIcon="@mipmap/ic_launcher_slide">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".IconAerochrome"
            android:targetActivity=".VaultActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_aerochrome"
            android:roundIcon="@mipmap/ic_launcher_aerochrome">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Hands a shared badge image to the app it is shared with; cache/shared only. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- No Google Maps API key needed — using OpenStreetMap (osmdroid) -->

        <!-- WorkManager: on-demand init via Configuration.Provider (HiltWorkerFactory),
             so the default startup initializer must be removed -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

    </application>
</manifest>
